# =================================================================
# 1. AI Agent & LLM (核心：防止 AI 历史干扰 Git 或泄露隐私)
# =================================================================
.aider*		# Aider 的聊天历史、元数据和缓存
# 忽略 Aider 的索引缓存（这是最重要的，它包含大量二进制数据）
.aider.tags.cache.v4/
# 忽略输入历史（保护你的隐私，防止 API Key 或敏感信息误输入）
.aider.input.history
# 聊天历史建议：如果你想在 Git 中保存 AI 解释，就注释掉下面这行；
# 但为了保持项目专注代码，建议忽略，只在本地查看。
.aider.chat.history.md
.cursor/	# 如果你偶尔使用 Cursor，忽略其内部索引
*.log		# 所有的运行日志
.env		# 绝对禁止提交 API 密钥文件
# =================================================================
# 2. 教材与多模态素材 (核心：版权保护与仓库瘦身)
# =================================================================
# 忽略原始参考资料（PDF、高分照片）
docs/reference/
# 但我们要保留经过你整理的笔记和处理后的 Markdown
!docs/processed/.gitkeep
# =================================================================
# 3. C++ 编译与构建 (针对 WSL2/Linux 环境)
# =================================================================
*.o
*.obj
*.exe
*.out
*.app
*.so
*.a
bin/		# 建议所有编译生成的二进制放这里
build/		# CMake 或手动构建目录
.vscode/	# 除非你要共享调试配置，否则建议忽略
.gdb_history	# GDB 调试历史

# =================================================================
# 4. MMIX 专用 (针对 TAOCP 模拟器)
# =================================================================
*.mmo                  # MMIX 编译后的二进制对象文件
*.mms.log              # MMIX 模拟器运行日志
mmix-visualizer/       # 如果下载了外部可视化工具

# =================================================================
# 5. Python 环境 (用于运行测试脚本或数据处理工具)
# =================================================================
__pycache__/
*.py[cod]
.venv/
env/
venv/
.python-version

# =================================================================
# 6. 系统与临时文件 (Windows + WSL2 混合环境)
# =================================================================
.DS_Store              # 如果你偶尔用 Mac
Thumbs.db              # Windows 缩略图
desktop.ini
*.swp                  # Vim 临时文件
.nfs* # 某些网络文件系统产生的临时文件
